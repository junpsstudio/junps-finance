{
  "name": "junps-finance",
  "version": "1.2.1",
  "description": "Junps Finance — studio manager: expenses, clients, invoices and goals",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "financas",
    "despesas",
    "controle"
  ],
  "author": "Junps Studio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.junpsstudios.financemanager",
    "productName": "Junps Finance",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "index.en.html",
      "thumbs.html",
      "build/icon.png",
      "build/icon.ico",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Junps-Finance-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "junpsstudio",
      "repo": "junps-finance",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "html2pdf.js": "^0.10.1",
    "electron-updater": "^6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/junpsstudio/junps-finance.git"
  }
}